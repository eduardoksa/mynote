# Copie este arquivo para .env e preencha os valores antes de subir o ambiente:
#   cp .env.example .env

# Senha do PostgreSQL (usada pelo container `db` no Docker Compose)
POSTGRES_PASSWORD=changeme

# URL de conexão com o banco de dados (usada pelo Rails)
DATABASE_URL=postgres://postgres:changeme@db:5432

# URL do Redis (Solid Queue, Solid Cache, Solid Cable)
REDIS_URL=redis://redis:6379/0

# Domínio usado nos links de email (ex: reset de senha) — obrigatório em produção
MAILER_HOST=seu-dominio.com
