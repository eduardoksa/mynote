<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
  </head>
  <body>
    <h1><%= t("user_mailer.password_reset.title") %></h1>
    <p><%= t("user_mailer.password_reset.greeting", name: @user.name) %></p>
    <p><%= t("user_mailer.password_reset.body") %></p>
    <p>
      <%= link_to t("user_mailer.password_reset.action"), @reset_url %>
    </p>
    <p><%= t("user_mailer.password_reset.expiry").html_safe %></p>
    <p><%= t("user_mailer.password_reset.disclaimer") %></p>
  </body>
</html>
